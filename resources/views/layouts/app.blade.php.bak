        .chat-input { padding: 12px 16px 16px; background: white; border-top: 1px solid #e2e8f0; }
        .chat-input form { margin: 0; }
        .chat-input .input-group {
            display: flex; align-items: center; gap: 6px;
            background: #f8fafc;
            border: 2px solid #e2e8f0;
            border-radius: 26px;
            padding: 4px 4px 4px 18px;
            transition: border-color 0.2s, box-shadow 0.2s, background 0.2s;
            flex-wrap: nowrap;
        }
        .chat-input .input-group:focus-within {
            border-color: #667eea;
            box-shadow: 0 0 0 3px rgba(102,126,234,0.12);
            background: white;
        }
        .chat-input .form-control {
            border: none !important; background: transparent !important;
            padding: 8px 0 !important; font-size: 0.9rem; outline: none; box-shadow: none !important;
            flex: 1 1 auto; min-width: 0; border-radius: 0 !important;
        }
        .chat-input .form-control:focus { border: none !important; box-shadow: none !important; }
        .chat-input .btn {
            border-radius: 50% !important; width: 38px; height: 38px; padding: 0;
            display: flex; align-items: center; justify-content: center;
            background: linear-gradient(135deg, #667eea, #764ba2); border: none;
            color: white; flex-shrink: 0;
            transition: transform 0.15s, opacity 0.15s;
        }
        .chat-input .btn:hover { transform: scale(1.06); }
        .chat-input .btn:disabled { opacity: 0.5; transform: none; cursor: not-allowed; }
        .typing-indicator { display: flex; gap: 4px; padding: 12px 16px; }
        .typing-dot {
            width: 8px; height: 8px; background: #94a3b8; border-radius: 50%;
            animation: typingBounce 1.4s infinite ease-in-out;
        }
        .typing-dot:nth-child(2) { animation-delay: 0.2s; }
        .typing-dot:nth-child(3) { animation-delay: 0.4s; }
        @keyframes typingBounce {
            0%, 80%, 100% { transform: scale(0.6); opacity: 0.4; }
            40% { transform: scale(1); opacity: 1; }
        }
        @media (max-width: 500px) {
            .chat-box { width: calc(100vw - 20px); right: 10px; bottom: 80px; height: 70vh; }
            .chat-toggle { bottom: 15px; right: 15px; }
        }
    </style>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script>
        // Sidebar toggle
        function toggleSidebar() {
            document.getElementById('sidebar').classList.toggle('show');
            document.getElementById('sidebarOverlay').classList.toggle('show');
        }
        function closeSidebar() {
            document.getElementById('sidebar').classList.remove('show');
            document.getElementById('sidebarOverlay').classList.remove('show');
        }
        // Close sidebar when nav link clicked on mobile
        document.querySelectorAll('.sidebar .nav-link').forEach(link => {
            link.addEventListener('click', () => { if (window.innerWidth <= 768) closeSidebar(); });
        });
        // Make tables responsive
        document.querySelectorAll('.card-body > .table, .card-body.p-0 > .table').forEach(table => {
            if (!table.parentElement.classList.contains('table-responsive')) {
                const wrapper = document.createElement('div');
                wrapper.className = 'table-responsive';
                table.parentNode.insertBefore(wrapper, table);
                wrapper.appendChild(table);
            }
        });
    </script>
    <script>
        let chatOpen = false;

        function toggleChat() {
            chatOpen = !chatOpen;
            document.getElementById('chatBox').classList.toggle('active', chatOpen);
            document.getElementById('chatBadge').style.display = 'none';
            if (chatOpen) {
                document.getElementById('chatInput').focus();
                const msgs = document.getElementById('chatMessages');
                msgs.scrollTop = msgs.scrollHeight;
            }
        }

        function sendMessage(e) {
            e.preventDefault();
            const input = document.getElementById('chatInput');
            const message = input.value.trim();
            if (!message) return;

            appendMessage(message, 'user');
            input.value = '';
            input.disabled = true;
            document.getElementById('sendBtn').disabled = true;

            showTyping();

            fetch('{{ route("chat.send") }}', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-CSRF-TOKEN': document.querySelector('meta[name="csrf-token"]').content,
                    'Accept': 'application/json',
                },
                body: JSON.stringify({ message })
            })
            .then(r => r.json())
            .then(data => {
                removeTyping();
                appendMessage(data.reply, 'bot', data.timestamp);
            })
            .catch(() => {
                removeTyping();
                appendMessage('문제가 발생했습니다. 다시 시도해 주세요.', 'bot');
            })
            .finally(() => {
                input.disabled = false;
                document.getElementById('sendBtn').disabled = false;
                input.focus();
            });
        }

        function appendMessage(text, type, time) {
            const msgs = document.getElementById('chatMessages');
            const timeStr = time || new Date().toLocaleTimeString('ko-KR', { hour: 'numeric', minute: '2-digit', hour12: true });

            // Convert **bold** to <strong>
            let html = text.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');
            // Convert \n to <br>
            html = html.replace(/\n/g, '<br>');

            const icon = type === 'bot' ? 'bi-robot' : 'bi-person-fill';
            const div = document.createElement('div');
            div.className = `message ${type}-message`;
            div.innerHTML = `
                <div class="message-avatar"><i class="bi ${icon}"></i></div>
                <div class="message-content">
                    <div class="message-bubble">${html}</div>
                    <div class="message-time">${timeStr}</div>
                </div>`;
            msgs.appendChild(div);
            msgs.scrollTop = msgs.scrollHeight;

            if (!chatOpen && type === 'bot') {
                document.getElementById('chatBadge').style.display = 'flex';
            }
        }

        function showTyping() {
            const msgs = document.getElementById('chatMessages');
            const div = document.createElement('div');
            div.className = 'message bot-message';
            div.id = 'typingIndicator';
            div.innerHTML = `
                <div class="message-avatar"><i class="bi bi-robot"></i></div>
                <div class="message-content">
                    <div class="message-bubble">
                        <div class="typing-indicator">
                            <div class="typing-dot"></div>
                            <div class="typing-dot"></div>
                            <div class="typing-dot"></div>
                        </div>
                    </div>
                </div>`;
            msgs.appendChild(div);
            msgs.scrollTop = msgs.scrollHeight;
        }

        function removeTyping() {
            const el = document.getElementById('typingIndicator');
            if (el) el.remove();
        }

        function clearChat() {
            if (!confirm('대화 기록을 모두 지울까요?')) return;
            fetch('{{ route("chat.clear") }}', {
                method: 'POST',
                headers: {
                    'X-CSRF-TOKEN': document.querySelector('meta[name="csrf-token"]').content,
                    'Accept': 'application/json',
                },
            });
            const msgs = document.getElementById('chatMessages');
            msgs.innerHTML = `
                <div class="message bot-message">
                    <div class="message-avatar"><i class="bi bi-robot"></i></div>
                    <div class="message-content">
                        <div class="message-bubble">
                            대화가 지워졌습니다. 🧹 무엇을 도와드릴까요?
                        </div>
                        <div class="message-time">${new Date().toLocaleTimeString('ko-KR', { hour: 'numeric', minute: '2-digit', hour12: true })}</div>
                    </div>
                </div>`;
        }

        // Keyboard shortcut: Ctrl+Shift+K to toggle chat
        document.addEventListener('keydown', function(e) {
            if (e.ctrlKey && e.shiftKey && e.key === 'K') {
                e.preventDefault();
                toggleChat();
            }
        });
    </script>
    @stack('scripts')
</body>
</html>
